DATABASE_URL=postgresql://user:password@localhost:5432/minecraftle?schema=public

# optional
NEXT_PUBLIC_PUBLIC_DIR=

# --- LFS fork: Discord activity (see docs/lfs/README.md) ---
# Without the Discord block the game runs as plain Minecraftle.

# Application id of the Discord application that owns the activity.
DISCORD_CLIENT_ID=
# Same id for the browser bundle. Optional: if empty, the browser asks
# /api/discord/config at runtime.
NEXT_PUBLIC_DISCORD_CLIENT_ID=
# OAuth2 client secret of that application. Server only.
DISCORD_CLIENT_SECRET=
# Guild whose members may save results.
DISCORD_GUILD_ID=
# Role in that guild that grants access.
MEMBER_ROLE_ID=
# Random string, at least 32 characters. Signs session tokens.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Internal Concierge API that receives finished games. Both empty: results
# are stored but not reported.
CONCIERGE_URL=
# Shared secret sent as X-Internal-Token to the Concierge.
INTERNAL_TOKEN=

# Compose only: password of the bundled PostgreSQL (docker-compose.lfs.yml).
POSTGRES_PASSWORD=

# Optional Google Analytics id, build time. Empty: no analytics. Never loaded
# inside Discord.
NEXT_PUBLIC_GA_ID=

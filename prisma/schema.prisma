// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id             Int       @id @default(autoincrement())
  user_id        String    @unique
  last_game_date DateTime?
}

model game_count {
  id         Int    @id @default(autoincrement())
  user_id    String
  attempts   Int
  game_count Int

  @@unique([user_id, attempts])
}

// Daily game of a Discord player, one row per player and puzzle (LFS fork).
model discord_game {
  id            Int       @id @default(autoincrement())
  discord_id    String
  puzzle_number Int
  puzzle_date   String
  guesses       Json
  tries         Int
  status        String
  started_at    DateTime  @default(now())
  finished_at   DateTime?
  reported_at   DateTime?

  @@unique([discord_id, puzzle_number])
}
